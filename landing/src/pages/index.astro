---
// index.astro - tracewing's landing page
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Ways from '../components/Ways.astro';
import Local from '../components/Local.astro';
import Reads from '../components/Reads.astro';
import Measured from '../components/Measured.astro';
import Chains from '../components/Chains.astro';
import GetStarted from '../components/GetStarted.astro';
import FAQ from '../components/FAQ.astro';
import { faq } from '../data/faq';
import { GITHUB_URL, SITE_URL } from '../data/site';

const pageTitle =
  'tracewing — the HTTP debugging proxy that keeps up with big sessions';
const pageDescription =
  "For everything your browser's DevTools can't see: mobile apps, desktop apps, servers and AI agents. See, pause and change every request they make — including the programs that read no proxy setting at all, which macOS hands over through a network extension and Windows and Linux route through an adapter of tracewing's own. A native HTTP(S) debugging proxy for Windows, macOS and Linux, built in Rust on GPUI: HTTP/1.1, HTTP/2, WebSocket and server-sent events decoded as they happen, breakpoints and rules to change traffic on the way, every value read where it stands, JSON-RPC and contract calls read as the calls they are, and a million flows that scroll at the display refresh rate. Free and open source, and nothing leaves your machine.";
const siteUrl = `${SITE_URL}/`;
const ogImage = new URL('/og-image.png', siteUrl).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'tracewing',
  url: siteUrl,
  description: pageDescription,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, Windows, macOS',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  image: ogImage,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  sameAs: [GITHUB_URL],
};
const faqData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path="/"
  keywords="http debugging proxy, https proxy, mitm proxy, charles proxy alternative, fiddler alternative, capture app without proxy settings, transparent proxy, network extension, websocket debugging, grpc debugging, protobuf, http/3, quic, json-rpc, web3 debugging, breakpoints, open source, Rust, tracewing"
  jsonLd={[structuredData, faqData]}
>
  <Hero />
  <Features />
  <Ways />
  <Local />
  <Reads />
  <Measured />
  <Chains />
  <GetStarted />
  <FAQ />
</BaseLayout>
