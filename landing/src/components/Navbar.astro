---
// Navbar.astro - the name, the sections, the hive's other apps, and the way
// to the source
import { GITHUB_URL, PRODUCTS, PRODUCT_ID } from '../data/site';

const links = [
  { href: '#what', text: 'What it does' },
  { href: '#measured', text: 'Measured' },
  { href: '#chains', text: 'JSON-RPC' },
  { href: '#get', text: 'Get it' },
];

// The Products menu shows the hive's other apps, not this one.
const others = PRODUCTS.filter((product) => product.id !== PRODUCT_ID);
---

<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-name">
      <img
        class="nav-mark"
        src="/favicon.svg"
        width="22"
        height="22"
        alt=""
        aria-hidden="true"
      />
      tracewing
    </a>
    <nav class="nav-links" aria-label="Sections">
      <div class="nav-dropdown" id="productsMenu">
        <button
          type="button"
          class="nav-trigger"
          id="productsBtn"
          aria-expanded="false"
          aria-controls="productsPanel"
          aria-haspopup="true"
        >
          Products
          <svg
            class="chevron"
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </button>

        <div
          class="dropdown-panel"
          id="productsPanel"
          role="menu"
          aria-labelledby="productsBtn"
        >
          {
            others.map((product) => (
              <a
                href={product.href}
                target="_blank"
                rel="noopener noreferrer"
                class="product-item"
                role="menuitem"
              >
                <img
                  src={product.icon}
                  width="34"
                  height="34"
                  alt=""
                  class="product-icon"
                />
                <span class="product-text">
                  <span class="product-name">
                    {product.name}
                    <span class="product-tagline">{product.tagline}</span>
                  </span>
                  <span class="product-desc">{product.description}</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>

      {links.map((link) => <a href={link.href}>{link.text}</a>)}
    </nav>
    <a
      href={GITHUB_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-secondary nav-source">Source</a
    >
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--header-height);
    display: flex;
    align-items: center;
    background: rgba(20, 21, 23, 0.82);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-name {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 800;
    font-size: 1.0625rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .nav-mark {
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 5px;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    margin-left: auto;
    font-size: 0.9375rem;
  }

  .nav-links a {
    color: var(--text-secondary);
  }

  .nav-links a:hover {
    color: var(--text-primary);
  }

  .nav-source {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }

  @media (max-width: 52rem) {
    .nav-links {
      display: none;
    }

    .nav-source {
      margin-left: auto;
    }
  }
  /* Products menu: the hive's other apps ---------------------------------
     The nav-links row goes away under 52rem, and this menu with it; the
     footer carries the same three links for a phone. */

  .nav-dropdown {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--text-secondary);
    cursor: pointer;
  }

  .nav-trigger:hover,
  .nav-dropdown.open .nav-trigger {
    color: var(--text-primary);
  }

  .chevron {
    transition: transform 0.2s ease;
  }

  .nav-dropdown.open .chevron {
    transform: rotate(180deg);
  }

  .dropdown-panel {
    position: absolute;
    top: calc(100% + 1.35rem);
    left: -1.1rem;
    width: 27rem;
    max-width: calc(100vw - 2 * var(--container-gutter));
    padding: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-card);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s;
  }

  /* Bridges the gap under the trigger, so the pointer can cross into the
     panel without it closing on the way. */
  .dropdown-panel::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 1.35rem;
  }

  .nav-dropdown.open .dropdown-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .product-item {
    display: flex;
    gap: 0.85rem;
    padding: 0.75rem;
    border-radius: 12px;
    border: 1px solid transparent;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product-item:hover,
  .product-item:focus-visible {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--border-hover);
    outline: none;
  }

  .product-icon {
    flex-shrink: 0;
    border-radius: 9px;
    margin-top: 0.1rem;
  }

  .product-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .product-name {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--text-primary);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .product-tagline {
    color: var(--accent-light);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .product-desc {
    color: var(--text-secondary);
    font-size: 0.82rem;
    line-height: 1.5;
  }

</style>

<script>
  // The Products menu: a click opens and closes it, a pointer opens it on the
  // way past, and Escape or a click outside closes it again.
  const productsMenu = document.getElementById('productsMenu');
  const productsBtn = document.getElementById('productsBtn');

  if (productsMenu && productsBtn) {
    const setOpen = (open: boolean) => {
      productsMenu.classList.toggle('open', open);
      productsBtn.setAttribute('aria-expanded', String(open));
    };

    productsBtn.addEventListener('click', (event) => {
      event.stopPropagation();
      setOpen(!productsMenu.classList.contains('open'));
    });

    // Only where there is a real pointer: on a touch screen the click above
    // does the work, and a hover would open the menu on the tap that follows.
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      productsMenu.addEventListener('mouseenter', () => setOpen(true));
      productsMenu.addEventListener('mouseleave', () => setOpen(false));
    }

    productsMenu.addEventListener('focusout', (event) => {
      if (!productsMenu.contains(event.relatedTarget as Node)) setOpen(false);
    });

    document.addEventListener('click', (event) => {
      if (!productsMenu.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && productsMenu.classList.contains('open')) {
        setOpen(false);
        productsBtn.focus();
      }
    });
  }
</script>
