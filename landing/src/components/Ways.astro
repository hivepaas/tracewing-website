---
// Ways.astro - the ways traffic reaches tracewing, under the question Set up
// asks over them.
//
// Nothing here is hidden behind the script: all seven ways are on the page as
// it is served, and choosing an answer only marks the one that reaches it. So
// with no JavaScript the section is a list of the ways in, which is what it
// would have been anyway — and the hint that invites a press is the one thing
// the script puts there, because without it the invitation would be a lie.
import { ANSWERS, WAYS } from '../data/ways';
import { CAPTURING_DOC_URL } from '../data/site';

const icons: Record<string, string> = {
  globe:
    '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"/>',
  browser:
    '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/>',
  terminal: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3M13 15h4"/>',
  phone:
    '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M11 18.5h2"/>',
  socket:
    '<path d="M9 3v5M15 3v5M6 8h12v3a6 6 0 0 1-12 0zM12 17v4"/>',
  tunnel:
    '<path d="M12 2.5 4.5 6v6c0 4.5 3.2 8.4 7.5 9.5 4.3-1.1 7.5-5 7.5-9.5V6z"/><path d="m8.8 12 2.2 2.2 4.2-4.4"/>',
  apps: '<rect x="3.5" y="3.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.6"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.6"/>',
};
---

<section class="section ways" id="ways">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Every way in</span>
      <h2>Say what you want to capture</h2>
      <p>
        A program comes through tracewing only when it is told to send its
        traffic there, and programs listen in different places. Set up asks one
        question and sets up the one way in that reaches your answer — the
        others stay off the page. <a href={CAPTURING_DOC_URL}
          >Which way takes which programs</a
        > is written down in full.
      </p>
    </div>

    <div class="picker" data-picker>
      <p class="picker-question">What do you want to capture?</p>
      <div class="pills" role="group" aria-label="What do you want to capture?">
        {
          ANSWERS.map((answer) => (
            <button
              type="button"
              class="pill"
              data-answer={answer.id}
              data-way={answer.way}
              aria-pressed="false"
            >
              {answer.text}
            </button>
          ))
        }
      </div>
      <p class="picker-hint" data-hint hidden>
        Press one, and the way in that reaches it is marked below.
      </p>
    </div>

    <div class="ways-grid">
      {
        WAYS.map((way) => (
          <article class="way" data-way-card={way.id}>
            <div class="way-head">
              <span class="way-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[way.icon]}
                />
              </span>
              <h3 class="way-name">
                {way.name}
                {way.windowsName && (
                  <span class="way-alias">{way.windowsName} on Windows</span>
                )}
              </h3>
              <span class="way-mark" data-mark hidden>
                reaches it
              </span>
            </div>
            <p class="way-line way-takes">
              <span class="way-label">Comes through</span>
              {way.takes}
            </p>
            <p class="way-line way-leaves">
              <span class="way-label">Does not</span>
              {way.leaves}
            </p>
          </article>
        ))
      }
    </div>

    <figure class="ways-shot">
      <img
        src="/shots/setup.webp"
        width="1600"
        height="1000"
        alt="tracewing's Set up page: the question with its answers, the certificate step, and the step for the way in the chosen answer leads to."
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        Set up, with <em>an app that ignores the proxy</em> answered: the certificate,
        then that one way in and nothing else.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .picker {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 16px;
    padding: var(--card-pad);
    margin-bottom: 1.25rem;
  }

  .picker-question {
    font-size: 1.0625rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pill {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border-card);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-secondary);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .pill:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .pill[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: #0d1a3a;
    font-weight: 600;
  }

  .picker-hint {
    margin-top: 0.9rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .ways-grid {
    display: grid;
    /* min(19rem, 100%), not a bare 19rem: on a screen narrower than the track
       a bare one would not shrink, and the page would scroll sideways. */
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .way {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: var(--card-pad);
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 16px;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  /* The one the chosen answer leads to. */
  .way.is-marked {
    border-color: var(--accent);
    background: var(--bg-card-hover);
    box-shadow: 0 0 0 1px var(--accent-glow);
  }

  /* Seven ways into a grid three wide leaves a last row with one card in it.
     The one the next section is about takes the whole of that row and reads
     across, so the row is meant rather than left over. */
  .way[data-way-card='apps'] {
    grid-column: 1 / -1;
  }

  @media (min-width: 48rem) {
    .way[data-way-card='apps'] {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'head head'
        'takes leaves';
      column-gap: 2.5rem;
    }

    .way[data-way-card='apps'] .way-head {
      grid-area: head;
    }

    .way[data-way-card='apps'] .way-takes {
      grid-area: takes;
    }

    .way[data-way-card='apps'] .way-leaves {
      grid-area: leaves;
    }
  }

  .way-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .way-icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 10px;
    background: rgba(122, 162, 255, 0.12);
    border: 1px solid rgba(122, 162, 255, 0.25);
    color: var(--accent-light);
  }

  .way-icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .way-name {
    font-size: 1.0625rem;
    font-weight: 700;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .way-alias {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .way-mark {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: rgba(122, 162, 255, 0.14);
    border: 1px solid rgba(122, 162, 255, 0.35);
    color: var(--accent-light);
  }

  .way-line {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .way-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.2rem;
  }

  .way-takes .way-label {
    color: var(--accent-emerald);
  }

  .way-leaves .way-label {
    color: var(--text-muted);
  }

  .ways-shot {
    margin: 0;
  }

  .ways-shot img {
    display: block;
    width: 100%;
    border: 1px solid var(--border-card);
    border-radius: 16px;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.7);
  }

  .ways-shot figcaption {
    margin-top: 1rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .way,
    .pill {
      transition: none;
    }
  }
</style>

<script>
  // Choosing an answer marks the way in that reaches it, as Set up does. The
  // cards are all on the page already: this only moves the mark.
  const picker = document.querySelector<HTMLElement>('[data-picker]');
  const cards = document.querySelectorAll<HTMLElement>('[data-way-card]');

  if (picker && cards.length) {
    const pills = picker.querySelectorAll<HTMLButtonElement>('[data-answer]');
    const hint = picker.querySelector<HTMLElement>('[data-hint]');

    // Only now is there anything to press, so only now does the page say so.
    if (hint) hint.hidden = false;

    const mark = (way: string | null) => {
      cards.forEach((card) => {
        const chosen = card.dataset.wayCard === way;
        card.classList.toggle('is-marked', chosen);
        const badge = card.querySelector<HTMLElement>('[data-mark]');
        if (badge) badge.hidden = !chosen;
      });
    };

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const already = pill.getAttribute('aria-pressed') === 'true';
        pills.forEach((other) =>
          other.setAttribute('aria-pressed', String(!already && other === pill))
        );
        // Pressing the chosen one again clears it, rather than leaving no way
        // to get back to the whole list unmarked.
        mark(already ? null : (pill.dataset.way ?? null));
      });
    });
  }
</script>
